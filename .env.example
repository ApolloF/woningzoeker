# Copy to .env and replace every value marked CHANGE_ME.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://woningzoeker:CHANGE_ME_DB_PASSWORD@db:5432/woningzoeker
POSTGRES_DB=woningzoeker
POSTGRES_USER=woningzoeker
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Generate with: docker compose run --rm --no-deps app python -m app.cli generate-secrets
# Keep the generated Argon2 hash in single quotes so Compose treats dollar signs literally.
ADMIN_PASSWORD_HASH='CHANGE_ME_ARGON2_HASH'
SESSION_SECRET_KEY=CHANGE_ME_LONG_RANDOM_VALUE
MASTER_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
DASHBOARD_COOKIE_SECURE=false

PUBLIC_BASE_URL=http://localhost:8000
DRY_RUN=true
AUTO_REACT_ENABLED=false
SCHEDULER_ENABLED=true
LOG_LEVEL=INFO

# Docker sets Chromium's path. Reaction screenshots contain private form data: protect artifacts.
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
BROWSER_TIMEOUT_SECONDS=40
REACTION_BROWSER_TIMEOUT_SECONDS=45
REACTION_ARTIFACT_DIR=/app/artifacts/submissions
REACTION_MAX_ATTEMPTS=3

# Automatic reactions require an enabled provider and a safe structured result.
LLM_PROVIDER=disabled
LLM_CHEAP_MODEL=
LLM_STANDARD_MODEL=
LLM_ESCALATION_MODEL=
LLM_TIMEOUT_SECONDS=45
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Optional. Notifications are audit-only when these are blank. User IDs are a JSON array.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=[]

# CAPTCHA Solving for automatic reactions: disabled, capsolver, anti_captcha
CAPTCHA_SOLVER_PROVIDER=disabled
CAPSOLVER_API_KEY=
ANTI_CAPTCHA_API_KEY=
CAPTCHA_SOLVER_TIMEOUT_SECONDS=120

# Human-in-the-loop CAPTCHA: when a challenge appears the browser session is held
# open and the live page is relayed to the dashboard (/assistance/solve/<id>) so you
# solve only the CAPTCHA on your phone; the agent then resumes and submits. A person
# always performs the challenge. Used as the fallback when no autonomous solver token
# is available.
CAPTCHA_INTERACTIVE_ENABLED=false
CAPTCHA_SOLVE_TIMEOUT_SECONDS=180

# Optional HTTPS profile: docker compose --profile proxy up -d --build
DOMAIN=localhost
ACME_EMAIL=
